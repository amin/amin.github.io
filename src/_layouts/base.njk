<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        {# One source for both, so the tab title and the share card cannot drift
           apart. A page may still override with its own `title` front matter. #}
        <title>{{ title or site.ogTitle }}</title>
        <meta name="description" content="{{ site.description }}">
        {# site.url carries no trailing slash and page.url always opens with
           one, so the two concatenate into exactly one origin and path. og:url
           below is built from the same pair on purpose: a share card claiming a
           different address than the canonical is the drift worth preventing.
           og:image stays a fixed path, since the card art does not vary. #}
        <link rel="canonical" href="{{ site.url }}{{ page.url }}">
        <link rel="icon" href="/favicon.svg" type="image/svg+xml">
        <link rel="apple-touch-icon" href="/apple-touch-icon.png">
        <meta property="og:type" content="website">
        <meta property="og:url" content="{{ site.url }}{{ page.url }}">
        <meta property="og:title" content="{{ site.ogTitle }}">
        <meta property="og:description" content="{{ site.description }}">
        <meta property="og:image" content="{{ site.url }}/og.png">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta name="twitter:card" content="summary_large_image">
        <link rel="stylesheet" href="/assets/styles/app.css">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link
            href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
            rel="stylesheet">
    </head>
    <body>
        <a class="skip-link" href="#main">Skip to content</a>
        {% include "header.njk" %}
        <main id="main" tabindex="-1">
            {% block content %}{% endblock %}
        </main>
        {% include "footer.njk" %}
        <script src="/assets/js/app.js"></script>
    </body>
</html>