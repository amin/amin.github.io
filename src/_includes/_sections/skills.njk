{# Each icon here sits beside a text label that already names it, so the SVG's
   own <title> is stripped — see the "decorative" filter in .eleventy.js. The
   projects tech row keeps its titles, because there the icons stand alone. #}
{% macro icon(path) %}{% set svg %}{% include path %}{% endset %}{{ svg | decorative | safe }}{% endmacro %}
<section class="section" data-link-id="4" id="skills">
    <div class="wrapper">
        <div class="skills-header">
            <div class="skills-intro">
                <span class="section-label">Skills</span>
                <h2>A modern, AI-assisted toolkit.</h2>
                {# "throughout my workflow" was dropped, not reworded: the hero
                   states the scope now, so repeating it here only said the same
                   thing twice two screens apart. The hero carries how far AI
                   reaches, this carries what it actually does. #}
                <p>Design and implementation are part of the same process. I use AI to explore ideas, work across languages and frameworks, and carry decisions through to implementation.</p>
            </div>
            <div class="skills-illustration">{% include "icons/toolkit-illustration.svg" %}</div>
        </div>
        <div class="skills-groups">
            {# One axis: which layer of the stack a thing belongs to. An earlier
               split ran Core / Delivery / Additional experience, which mixed two
               axes — the first and last measured depth, the middle named a
               domain — so nothing predicted where an entry would land, and
               Tailwind and Turborepo ended up filed under "Additional" while
               shipping in every project.

               Depth is Projects' job, not this section's. Two shipped repos
               argue it better than a self-assessment can, and they sit directly
               above. This answers what is in the toolbox; Projects answers what
               has been built with it. #}
            <div class="skills-group">
                <span class="skills-group-label">Frontend</span>
                <ul>
                    <li><span class="skill-icon" aria-hidden="true">{{ icon("icons/react.svg") }}</span>React</li>
                    <li><span class="skill-icon" aria-hidden="true">{{ icon("icons/tailwind.svg") }}</span>Tailwind</li>
                    <li><span class="skill-icon" aria-hidden="true">{{ icon("icons/nextjs.svg") }}</span>Next.js</li>
                    {# Sits here rather than with the tooling: the intro above
                       says design and implementation are one process, so the
                       design tool belongs beside what it becomes. #}
                    <li><span class="skill-icon" aria-hidden="true">{{ icon("icons/figma.svg") }}</span>Figma</li>
                </ul>
            </div>
            <div class="skills-group">
                <span class="skills-group-label">Backend</span>
                <ul>
                    {# TypeScript and JavaScript lead here, not Frontend. Yrco's
                       API is JavaScript end to end, and React implies both to
                       any reader — listing them opposite would understate where
                       the work actually happens. #}
                    <li><span class="skill-icon" aria-hidden="true">{{ icon("icons/typescript.svg") }}</span>TypeScript</li>
                    <li><span class="skill-icon" aria-hidden="true">{{ icon("icons/javascript.svg") }}</span>JavaScript</li>
                    <li><span class="skill-icon" aria-hidden="true">{{ icon("icons/nodejs.svg") }}</span>Node.js</li>
                    <li><span class="skill-icon" aria-hidden="true">{{ icon("icons/express.svg") }}</span>Express</li>
                    <li><span class="skill-icon" aria-hidden="true">{{ icon("icons/php.svg") }}</span>PHP</li>
                    <li><span class="skill-icon" aria-hidden="true">{{ icon("icons/laravel.svg") }}</span>Laravel</li>
                    <li><span class="skill-icon" aria-hidden="true">{{ icon("icons/sql.svg") }}</span>SQL</li>
                    <li><span class="skill-icon" aria-hidden="true">{{ icon("icons/mongodb.svg") }}</span>MongoDB</li>
                    <li><span class="skill-icon" aria-hidden="true">{{ icon("icons/firebase.svg") }}</span>Firebase</li>
                </ul>
            </div>
            <div class="skills-group">
                <span class="skills-group-label">Infrastructure</span>
                <ul>
                    {# Leads the group. The section heading claims an AI-assisted
                       toolkit and the hero claims AI throughout the workflow —
                       this is the only entry backing either. It is the one loose
                       fit in the taxonomy: AI runs across all three layers, and
                       the hero says as much by placing it outside its triad. #}
                    <li><span class="skill-icon" aria-hidden="true">{{ icon("icons/claude.svg") }}</span>Claude</li>
                    <li><span class="skill-icon" aria-hidden="true">{{ icon("icons/git.svg") }}</span>Git</li>
                    <li><span class="skill-icon" aria-hidden="true">{{ icon("icons/linux.svg") }}</span>Linux</li>
                    <li><span class="skill-icon" aria-hidden="true">{{ icon("icons/docker.svg") }}</span>Docker</li>
                    {# Kept adjacent: both projects run Turborepo over pnpm
                       workspaces, and this site is built the same way. #}
                    <li><span class="skill-icon" aria-hidden="true">{{ icon("icons/turborepo.svg") }}</span>Turborepo</li>
                    <li><span class="skill-icon" aria-hidden="true">{{ icon("icons/pnpm.svg") }}</span>pnpm</li>
                    <li><span class="skill-icon" aria-hidden="true">{{ icon("icons/cicd.svg") }}</span>CI/CD</li>
                    <li><span class="skill-icon" aria-hidden="true">{{ icon("icons/railway.svg") }}</span>Railway</li>
                    <li><span class="skill-icon" aria-hidden="true">{{ icon("icons/cloudflare.svg") }}</span>Cloudflare</li>
                </ul>
            </div>
        </div>
    </div>
</section>
