<section class="section" data-link-id="3" id="skills">
    <div class="wrapper">
        <div class="skills-header">
            <div class="skills-intro">
                <span class="section-label">Skills</span>
                <h2>A modern, AI-assisted toolkit.</h2>
                <p>Design and implementation are part of the same process. I use AI throughout my workflow to explore ideas, work across languages and frameworks, and carry decisions through to implementation.</p>
            </div>
            <div class="skills-illustration">{% include "icons/toolkit-illustration.svg" %}</div>
        </div>
        <div class="skills-groups">
            <div class="skills-group">
                <span class="skills-group-label">Code</span>
                <ul>
                    <li><span class="skill-icon">{% include "icons/javascript.svg" %}</span>JavaScript</li>
                    <li><span class="skill-icon">{% include "icons/typescript.svg" %}</span>TypeScript</li>
                    <li><span class="skill-icon">{% include "icons/nodejs.svg" %}</span>Node.js</li>
                    <li><span class="skill-icon">{% include "icons/react.svg" %}</span>React</li>
                    <li><span class="skill-icon">{% include "icons/nextjs.svg" %}</span>Next.js</li>
                    <li><span class="skill-icon">{% include "icons/tailwind.svg" %}</span>Tailwind</li>
                    <li><span class="skill-icon">{% include "icons/php.svg" %}</span>PHP</li>
                    <li><span class="skill-icon">{% include "icons/laravel.svg" %}</span>Laravel</li>
                </ul>
            </div>
            <div class="skills-group">
                <span class="skills-group-label">Data</span>
                <ul>
                    <li><span class="skill-icon">{% include "icons/sql.svg" %}</span>SQL</li>
                    <li><span class="skill-icon">{% include "icons/mongodb.svg" %}</span>MongoDB</li>
                    <li><span class="skill-icon">{% include "icons/firebase.svg" %}</span>Firebase</li>
                </ul>
            </div>
            <div class="skills-group">
                <span class="skills-group-label">Workflow</span>
                <ul>
                    <li><span class="skill-icon">{% include "icons/claude.svg" %}</span>Claude.ai</li>
                    <li><span class="skill-icon">{% include "icons/figma.svg" %}</span>Figma</li>
                    <li><span class="skill-icon">{% include "icons/fedora.svg" %}</span>Linux (Fedora)</li>
                    <li><span class="skill-icon">{% include "icons/git.svg" %}</span>Git</li>
                    <li><span class="skill-icon">{% include "icons/docker.svg" %}</span>Docker</li>
                    <li><span class="skill-icon">{% include "icons/pnpm.svg" %}</span>pnpm</li>
                    <li><span class="skill-icon">{% include "icons/turborepo.svg" %}</span>Turborepo</li>
                    <li><span class="skill-icon">{% include "icons/cicd.svg" %}</span>CI/CD</li>
                    <li><span class="skill-icon">{% include "icons/cloudflare.svg" %}</span>Cloudflare</li>
                </ul>
            </div>
        </div>
    </div>
</section>
