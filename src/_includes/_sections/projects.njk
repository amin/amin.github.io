<section class="section" data-link-id="3" id="projects">
    <div class="wrapper">
        <span class="section-label">Projects</span>
        <h2>A few things that shipped.</h2>
        <ul class="projects-list">
            {% for project in projects %}
            <li>
                {# The wordmark is the heading, so the heading had no text: a
                   parser that strips SVG saw an empty <h3>, and the outline of
                   the page lost both project names. The name is spelled out
                   here and hidden visually.

                   Both wordmarks are aria-hidden, like brand/github.svg beside
                   its own label. Left announceable they would pair with the
                   span and read the name twice — the same fault the decorative
                   filter exists to prevent in the skills list. #}
                {% if project.logo %}
                <h3 class="project-logo">{% include project.logo %}<span class="visually-hidden">{{ project.name }}</span></h3>
                {% elif project.logoImage %}
                <h3 class="project-logo"><img src="{{ project.logoImage }}" alt="" eleventy:widths="180,360,540"><span class="visually-hidden">{{ project.name }}</span></h3>
                {% else %}
                <h3 class="project-name">{{ project.name }}</h3>
                {% endif %}
                {# The description carries no label. Sitting directly under the
                   wordmark it is obviously the description, and labelling it
                   cost a rule and 51px an entry to say so. Role and
                   Architecture are not self-evident, so they keep theirs.

                   Each label sits inside its paragraph rather than beside it. A
                   sibling would add a child per label, and the desktop subgrid
                   counts children — see the row count in _projects.scss. #}
                <p class="project-description">{{ project.description }}</p>
                {% if project.role %}
                <p class="project-role"><span class="project-label">Role</span>{{ project.role }}</p>
                {% endif %}
                {% if project.architecture %}
                <p class="project-architecture"><span class="project-label">Architecture</span>{{ project.architecture }}</p>
                {% endif %}
                <ul class="project-tech">
                    {% for icon in project.tech %}
                    <li>{% include icon %}</li>
                    {% endfor %}
                </ul>
                <div class="project-links">
                    {% if project.links.live %}
                    <a href="{{ project.links.live }}" target="_blank" rel="noopener noreferrer">{{ project.links.live | replace("https://", "") }}</a>
                    {% endif %}
                    {% if project.links.github %}
                    <a href="{{ project.links.github }}" target="_blank" rel="noopener noreferrer">{% include "icons/brand/github.svg" %}GitHub</a>
                    {% endif %}
                </div>
            </li>
            {% endfor %}
        </ul>
    </div>
</section>
